# Copy this file to `.env` (which is gitignored) and fill in your values.
# The CLI auto-loads `.env` on startup via python-dotenv.

# REQUIRED: your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OPTIONAL: pin specific models per role.
# Project defaults (per Austin's recommendation, May 2026):
#   fast     = gpt-5-mini   (extraction, profile, lens, value types)
#   smart    = gpt-5.2      (research, CVC, weak links, decoupling, business model, competitive, judgment)
#   research = gpt-5.2      (research synthesis adapter)
# MGT470_MODEL_FAST=gpt-5-mini
# MGT470_MODEL_SMART=gpt-5.2
# MGT470_MODEL_RESEARCH=gpt-5.2

# OPTIONAL: per-role reasoning_effort (none | low | medium | high).
# Defaults: fast=low, smart=medium, research=medium.
# MGT470_EFFORT_FAST=low
# MGT470_EFFORT_SMART=medium
# MGT470_EFFORT_RESEARCH=medium

# OPTIONAL: force the offline (deterministic fake) backend even if a key is set.
# MGT470_OFFLINE=1

# OPTIONAL: research backend. Defaults to gpt_researcher when OPENAI_API_KEY is
# set and MGT470_OFFLINE is not 1. Use stub for the pre-Phase-2 knowledge-only
# adapter, including CI and deterministic offline runs.
# MGT470_RESEARCH_BACKEND=gpt_researcher
# MGT470_RESEARCH_BACKEND=stub

# OPTIONAL: Tavily search backend for gpt-researcher power users. If unset,
# gpt-researcher uses its free DuckDuckGo path by default.
# TAVILY_API_KEY=tvly-...
